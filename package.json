{
  "name": "matrimony-backend",
  "version": "2.0.0",
  "description": "Matrimony Admin + Flutter Backend API",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
