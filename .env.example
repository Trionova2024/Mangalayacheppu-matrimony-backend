# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://matrimony_user:StrongPassword123@localhost:5432/matrimony_db"

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET="change_this_to_a_long_random_secret_min_32_chars"
JWT_EXPIRES_IN="7d"

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── Admin Seed ─────────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@matrimony.com"
ADMIN_PASSWORD="Admin@123"
ADMIN_NAME="Super Admin"

# ── Cashfree ───────────────────────────────────────────────────────────────────
CASHFREE_APP_ID="xxxxxxxxxxxxxxxxxxxxxxxx"
CASHFREE_SECRET_KEY="cfsk_ma_prod_xxxxxxxxxxxxxxxxxxxxxxxx"
# CASHFREE_WEBHOOK_SECRET="optional_webhook_secret_if_configured" # falls back to CASHFREE_SECRET_KEY
CASHFREE_API_VERSION="2026-01-01"
CASHFREE_ENV="sandbox"   # sandbox | production

# ── Firebase Admin SDK ─────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# ── File Upload ────────────────────────────────────────────────────────────────
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=5


#aws
AWS_REGION=location
S3_BUCKET_NAME=bucket name
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""