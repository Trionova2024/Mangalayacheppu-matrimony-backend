# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://matrimony_user:StrongPassword123@localhost:5432/matrimony_db"

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET="change_this_to_a_long_random_secret_min_32_chars"
JWT_EXPIRES_IN="7d"

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── Admin Seed ─────────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@matrimony.com"
ADMIN_PASSWORD="Admin@123"
ADMIN_NAME="Super Admin"

# ── Payment Provider Selection ─────────────────────────────────────────────────
# Supported values: CASHFREE (default), IAP (Google Play In-App Purchase)
PAYMENT_PROVIDER="CASHFREE"

# ── Google Play In-App Purchase (Required when PAYMENT_PROVIDER=IAP) ────────────
GOOGLE_PLAY_PACKAGE_NAME="com.trionova.matrimony"
# Can be raw JSON string or path to service account key file
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
# Optional: Pub/Sub Topic and push verification token for Real-Time Developer Notifications (RTDN)
GOOGLE_PLAY_PUBSUB_TOPIC="projects/your-project-id/topics/play-subs"
GOOGLE_PLAY_PUBSUB_VERIFICATION_TOKEN="optional_secure_pubsub_token"
# Optional: Server-side JSON mapping between Google Play product IDs and internal package IDs
# GOOGLE_PLAY_PRODUCT_MAPPING='{"sub_bronze_monthly":"pkg-bronze","pkg_bronze":"pkg-bronze"}'

# ── Apple In-App Purchase (iOS App Store) ──────────────────────────────────────
APPLE_BUNDLE_ID="com.trionova.matrimony"
# App Store Connect App-Specific Shared Secret (for receipt validation):
APPLE_SHARED_SECRET="optional_app_specific_shared_secret_from_app_store_connect"
APPLE_IAP_ENV="production"   # sandbox | production
# Optional: Server-side JSON mapping between Apple product IDs and internal package IDs
# APPLE_PRODUCT_MAPPING='{"sub_gold_monthly":"pkg-gold","credits_25":"pkg-bronze"}'

# ── Cashfree ───────────────────────────────────────────────────────────────────
CASHFREE_APP_ID="xxxxxxxxxxxxxxxxxxxxxxxx"
CASHFREE_SECRET_KEY="cfsk_ma_prod_xxxxxxxxxxxxxxxxxxxxxxxx"
# CASHFREE_WEBHOOK_SECRET="optional_webhook_secret_if_configured" # falls back to CASHFREE_SECRET_KEY
CASHFREE_API_VERSION="2026-01-01"
CASHFREE_ENV="sandbox"   # sandbox | production

# ── Razorpay (Legacy / Mobile App Gateway) ─────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"


# ── Firebase Admin SDK ─────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# ── File Upload ────────────────────────────────────────────────────────────────
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=5


#aws
AWS_REGION=location
S3_BUCKET_NAME=bucket name
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""