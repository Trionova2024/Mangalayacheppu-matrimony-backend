# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://matrimony_user:StrongPassword123@localhost:5432/matrimony_db"

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET="change_this_to_a_long_random_secret_min_32_chars"
JWT_EXPIRES_IN="7d"

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── Admin Seed ─────────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@matrimony.com"
ADMIN_PASSWORD="Admin@123"
ADMIN_NAME="Super Admin"

# ── Google Play In-App Purchase (Android, required) ────────────────────────────
GOOGLE_PLAY_PACKAGE_NAME="com.services.mangalyacheppu"
# Can be raw JSON string or path to service account key file
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
# Optional: Server-side JSON mapping between Google Play product IDs and internal package IDs
# GOOGLE_PLAY_PRODUCT_MAPPING='{"sub_bronze_monthly":"pkg-bronze","pkg_bronze":"pkg-bronze"}'
# Automatic Google Play product creation when admins create/update paid packages
# (service account needs the "Manage store presence" permission in Play Console).
# Set to false to manage Play Console products manually (e.g. local development).
GOOGLE_PLAY_SYNC_PRODUCTS="true"
# Optional overrides for created products (defaults shown)
# GOOGLE_PLAY_PRODUCT_REGION="IN"
# GOOGLE_PLAY_PRODUCT_CURRENCY="INR"
# GOOGLE_PLAY_PRODUCT_LANGUAGE="en-US"   # must match the app's default language in Play Console
# GOOGLE_PLAY_REGIONS_VERSION="2022/02"

# ── Apple In-App Purchase (iOS App Store) ──────────────────────────────────────
# Off until StoreKit signed-transaction verification is implemented; Apple endpoints return 404
APPLE_IAP_ENABLED="false"
APPLE_BUNDLE_ID="com.trionova.matrimony"
# App Store Connect App-Specific Shared Secret (for receipt validation):
APPLE_SHARED_SECRET="optional_app_specific_shared_secret_from_app_store_connect"
APPLE_IAP_ENV="production"   # sandbox | production
# Optional: Server-side JSON mapping between Apple product IDs and internal package IDs
# APPLE_PRODUCT_MAPPING='{"sub_gold_monthly":"pkg-gold","credits_25":"pkg-bronze"}'


# ── Firebase Admin SDK ─────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# ── File Upload ────────────────────────────────────────────────────────────────
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=5


#aws
AWS_REGION=location
S3_BUCKET_NAME=bucket name
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""